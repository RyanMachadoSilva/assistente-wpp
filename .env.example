# Copie este arquivo para ".env" e preencha. O .env NUNCA vai para o GitHub.

# Qual IA usar: gemini (grátis, com limite diário) ou anthropic (pago, mais confiável)
PROVEDOR=gemini

# Chave do Gemini (grátis): https://aistudio.google.com > Get API key
GEMINI_API_KEY=

# Chave da Anthropic (só se PROVEDOR=anthropic): https://console.anthropic.com
ANTHROPIC_API_KEY=

# Modelo (deixe vazio para o padrão: gemini-3.5-flash-lite ou claude-sonnet-5-5).
# Mais esperto, porém mais lento: gemini-3.8-flash
MODELO=

# Quanto o Gemini "pensa" antes de responder: minimal, low, medium ou high (padrão: low).
# Menos = responde mais rápido. Se o modelo não aceitar, o assistente ignora sozinho.
PENSAMENTO=low

# Modelo para entender áudios (vazio = o mesmo do MODELO). Usa sempre a GEMINI_API_KEY.
MODELO_AUDIO=

# Quem pode usar o assistente: número (com DDI e DDD) e nome, separados por vírgula.
# Cada pessoa tem suas próprias tarefas, lembretes, rotinas e notas, e uma não vê as da outra.
# Mensagens de qualquer outro número são ignoradas.
# O assistente também só consegue mandar mensagem ("manda pra Lelê que...") para quem está aqui.
USUARIOS=5534999999999:Ryan,5534988888888:NomeDaNamorada

# Seu nome (usado só no MODO_PROPRIO)
NOME_USUARIO=Ryan

# true = o assistente roda no SEU próprio WhatsApp ("Mensagem para mim mesmo")
# false = o assistente roda num número separado (recomendado)
MODO_PROPRIO=false

# Horário do resumo diário (HH:MM). Deixe vazio para desativar.
RESUMO_HORA=07:00

# Fuso horário
TZ=America/Sao_Paulo
